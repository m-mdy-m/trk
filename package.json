{
  "name": "trk",
  "version": "0.1.0",
  "description": "Minimal CLI time tracker",
  "author": "m-mdy-m <bitsgenix@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/m-mdy-m/trk.git"
  },
  "bin": {
    "trk": "./dist/main.js"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:e2e": "jest --testPathPattern=test/e2e",
    "test:cov": "jest --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepare": "husky",
    "migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "better-sqlite3": "^9.4.3",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "dayjs": "^1.11.10",
    "js-yaml": "^4.1.0",
    "nest-commander": "^3.13.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/testing": "^10.3.0",
    "@swc/cli": "^0.3.9",
    "@swc/core": "^1.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.24",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.module.ts", "!src/main.ts"],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@database/(.*)$": "<rootDir>/src/database/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@logger/(.*)$": "<rootDir>/src/logger/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1"
    }
  },
  "lint-staged": {
    "*.ts": ["prettier --write"]
  }
}