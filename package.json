{
 "name": "trk",
  "version": "0.1.0",
  "description": "Minimal time tracking and reporting for developers",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "trk": "./bin/trk"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:binary": "pkg . --compress Brotli --out-path build",
    "start": "node dist/main.js",
    "test": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "biome check src tests",
    "lint:fix": "biome check --apply src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "clean": "rimraf dist build coverage"
  },
  "keywords": [
    "time-tracking",
    "productivity",
    "cli",
    "timer",
    "reporting"
  ],
  "author": "TRK Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-mdy-m/trk.git"
  },
  "bugs": {
    "url": "https://github.com/m-mdy-m/trk/issues"
  },
  "homepage": "https://github.com/m-mdy-m/trk#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "better-sqlite3": "^9.2.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dayjs": "^1.11.10",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.4.1",
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "pkg": "^5.8.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": ["node_modules/better-sqlite3/**/*"],
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "build"
  },
  "lint-staged": {
    "*.{ts,json,md}": ["biome check --apply", "biome format --write"]
  }
}
