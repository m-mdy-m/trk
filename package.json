{
  "name": "trk",
  "version": "0.1.0",
  "description": "Minimal CLI time tracker — event-driven, local-first",
  "author": "m-mdy-m <bitsgenix@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/m-mdy-m/trk.git"
  },
  "bugs": {
    "url": "https://github.com/m-mdy-m/trk/issues"
  },
  "bin": {
    "trk": "./dist/main.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start": "node dist/main.js",
    "prepare": "husky",
    "migrate": "ts-node -r tsconfig-paths/register src/core/database/migrate.ts",
    "clean": "pnpm -r clean",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "coverage": "nyc --reporter=text-summary pnpm test && nyc report --reporter=text-summary > coverage.md",
    "version": "changeset version",
    "release": "pnpm build && pnpm changeset publish",
    "release:alpha": "pnpm build && pnpm changeset publish --tag alpha",
    "release:beta": "pnpm build && pnpm changeset publish --tag beta",
    "release:next": "pnpm build && changeset publish --tag next"
  },
  "dependencies": {
    "@glandjs/events": "^1.1.2",
    "better-sqlite3": "^9.4.3",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^13.1.0",
    "dayjs": "^1.11.10",
    "js-yaml": "^4.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.24",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "tsx": "^4.19.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "**/*.ts": "prettier --ignore-path ./.prettierignore --write"
  }
}